        <mxCell id="scr3-81" parent="scr3-80" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;" value="利用API" vertex="1">
          <mxGeometry width="160" height="142" as="geometry" />
