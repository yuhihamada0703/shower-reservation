          <mxGeometry y="1713" width="920" height="44" as="geometry" />
        </mxCell>
        <mxCell id="scr3-90" parent="scr3-89" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;" value="対象ユーザー / 権限" vertex="1">
