        <mxCell id="m2VeV6oZEk3ODdzBXJ4u-60" parent="9AOleTEniNvB85iuekh9-1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;" value="1対多" vertex="1">
